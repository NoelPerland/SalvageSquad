/outputs/SalvageSquad/[Bb]uilds/
/outputs/SalvageSquad/[Mm]emoryCaptures/
/outputs/SalvageSquad/[Rr]ecordings/
/outputs/SalvageSquad/.env*
*.p12
*.pfx
*.keystore
